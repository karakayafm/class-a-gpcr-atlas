{
  "reference": "component_class_reference",
  "phase": 2,
  "description": "Chemical-class reference for non-polymer components. Its ONLY job is to describe what a component is chemically and what it is normally present for. It does NOT select ligands: a component becomes a pharmacological ligand solely through a per-structure source annotation (see config/ligand_roles.json). Consequently a component left unclassified here can never be silently promoted to a ligand — it is reported as unresolved and reviewed.",
  "sources": [
    {
      "name": "PDB Chemical Component Dictionary (via RCSB chem_comp)",
      "used_for": "type, name, formula, formula weight, heavy-atom count",
      "url": "https://www.wwpdb.org/data/ccd"
    },
    {
      "name": "Curated component table (this project)",
      "used_for": "environment classes the CCD type cannot distinguish: lipid vs detergent vs buffer",
      "basis": "component identity and IUPAC/common name as recorded in the CCD entry itself"
    }
  ],
  "precedence": [
    "1. explicit component id in curated_components",
    "2. ccd_type_rules (structural CCD classification)",
    "3. name_pattern_rules",
    "4. unresolved"
  ],
  "ccd_type_rules": [
    {
      "match_ccd_type_contains": "saccharide",
      "biological_type": "carbohydrate",
      "default_role": "glycan_or_post_translational_component",
      "rationale": "The CCD classifies these as saccharides; in GPCR entries they are N-linked glycans."
    },
    {
      "match_ccd_type_contains": "peptide linking",
      "biological_type": "amino_acid_or_short_fragment",
      "default_role": "unresolved",
      "rationale": "A free or linking amino acid may be an additive or a genuine ligand; the CCD type cannot tell, so it is reviewed."
    },
    {
      "match_ccd_type_contains": "peptide COOH",
      "biological_type": "amino_acid_or_short_fragment",
      "default_role": "unresolved",
      "rationale": "As above."
    },
    {
      "match_ccd_type_contains": "RNA linking",
      "biological_type": "nucleotide_or_nucleoside",
      "default_role": "unresolved",
      "rationale": "Nucleotides are ligands in the Nucleotide family and transducer cofactors in G-protein complexes; the binding partner decides, not the chemistry."
    },
    {
      "match_ccd_type_contains": "DNA linking",
      "biological_type": "nucleotide_or_nucleoside",
      "default_role": "unresolved",
      "rationale": "As above."
    }
  ],
  "ion_rule": {
    "condition": "heavy atom count == 1 AND the CCD name ends with ' ION'",
    "biological_type": "ion",
    "default_role": "environment_ion",
    "rationale": "Per OD-08 an ion is environment by default. This explicitly includes sodium, including the conserved 2x50 sodium pocket, which is a motif cofactor rather than a pharmacological ligand. Only an explicit source annotation may override this, and doing so requires manual review.",
    "excluded_ids": [
      "UNX",
      "NH2"
    ],
    "excluded_rationale": "UNX is 'unknown atom or ion' and carries no chemical identity; NH2 is an amino group, not an ion. Both go to unresolved."
  },
