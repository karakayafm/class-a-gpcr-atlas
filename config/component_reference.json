  "name_pattern_rules": [
    {
      "pattern": "POLYETHYLENE GLYCOL",
      "biological_type": "small_molecule",
      "default_role": "buffer_or_crystallization_additive",
      "rationale": "PEG series."
    },
    {
      "pattern": "GLYCOL",
      "biological_type": "small_molecule",
      "default_role": "buffer_or_crystallization_additive",
      "rationale": "Glycol cryoprotectants."
    },
    {
      "pattern": "MALTOSIDE",
      "biological_type": "small_molecule",
      "default_role": "detergent",
      "rationale": "Maltoside detergent series."
    },
    {
      "pattern": "GLUCOPYRANOSIDE",
      "biological_type": "small_molecule",
      "default_role": "detergent",
      "rationale": "Glucoside detergent series."
    },
    {
      "pattern": "PHOSPHOCHOLINE",
      "biological_type": "lipid",
      "default_role": "membrane_lipid",
      "rationale": "Phospholipid headgroup."
    },
    {
      "pattern": "PHOSPHATIDYL",
      "biological_type": "lipid",
      "default_role": "membrane_lipid",
      "rationale": "Phospholipid series."
    },
    {
      "pattern": "CHOLESTEROL",
      "biological_type": "lipid",
      "default_role": "membrane_lipid",
      "rationale": "Sterol series."
    },
    {
      "pattern": "FATTY ACID",
      "biological_type": "lipid",
      "default_role": "membrane_lipid",
      "rationale": "Free fatty acids."
    },
    {
      "pattern": "RETINAL",
      "biological_type": "retinal_or_chromophore",
      "default_role": "unresolved",
      "rationale": "Chromophore; role requires a source annotation."
    }
  ],
  "unmatched_policy": "A component matching nothing above is emitted with biological_type=unknown and ligand_role=unresolved, and is added to the manual review queue. It is never assigned a role by guesswork and never becomes a pharmacological ligand without a source annotation."
}
