{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["pdb_id", "title", "deposited", "released", "revision", "primary_citation"],
  "additionalProperties": false,
  "properties": {
    "pdb_id": {"type": "string", "pattern": "^[0-9A-Z]{4}$"},
    "title": {"type": ["string", "null"]},
    "deposited": {"type": ["string", "null"]},
    "released": {"type": ["string", "null"]},
    "revision": {"type": ["string", "null"]},
    "primary_citation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authors", "title", "journal", "year", "volume", "pages", "page_last", "doi", "pubmed_id"],
          "properties": {
            "authors": {"type": "array", "items": {"type": "string"}},
            "title": {"type": ["string", "null"]},
            "journal": {"type": ["string", "null"]},
            "year": {"type": ["integer", "null"]},
            "volume": {"type": ["string", "null"]},
            "pages": {"type": ["string", "null"]},
            "page_last": {"type": ["string", "null"]},
            "doi": {"type": ["string", "null"]},
            "pubmed_id": {"type": ["string", "null"]}
          }
        }
      ]
    }
  }
}
