{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/class-a-gpcr-atlas/schemas/source_manifest.schema.json",
  "title": "Source manifest",
  "description": "Which sources produced an artefact, under which licence, and the hashes of the inputs it was derived from.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schema_version",
    "parser_version",
    "sources",
    "derivation"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "parser_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Volatile: excluded from content_sha256."
    },
    "family_source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "family_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "provider",
          "license",
          "license_page"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "description": "Verbatim from the provider's own licence page. An unverified licence must say so; it must never be stated as verified."
          },
          "license_page": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "not_used": {
      "type": [
        "object",
        "null"
      ],
      "description": "Sources deliberately not called in this phase, with the reason."
    },
    "upstream_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "content_sha256"
        ],
        "properties": {
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "derivation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
