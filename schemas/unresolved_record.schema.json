{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/class-a-gpcr-atlas/schemas/unresolved_record.schema.json",
  "title": "Unresolved records",
  "description": "Records that failed a join or a check. They remain in the universe; this file is the audit trail, not an exclusion list.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schema_version",
    "parser_version",
    "policy",
    "counts",
    "records"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "parser_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Volatile: excluded from content_sha256."
    },
    "family_source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "pdb_id"
        ],
        "properties": {
          "pdb_id": {
            "type": "string"
          },
          "receptor_entry": {
            "type": [
              "string",
              "null"
            ]
          },
          "qc_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
