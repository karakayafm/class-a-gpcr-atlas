{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/class-a-gpcr-atlas/schemas/receptor.schema.json",
  "title": "Receptor record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "parser_version",
    "family_source_id",
    "family_name",
    "counts",
    "receptors"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "parser_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Volatile: excluded from content_sha256."
    },
    "family_source_id": {
      "type": "string"
    },
    "family_name": {
      "type": "string"
    },
    "receptor_families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "name",
          "project_slug"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "project_slug": {
            "type": "string"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "receptors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "receptor_entry_name",
          "species",
          "major_family_source_id",
          "receptor_family_source_id"
        ],
        "properties": {
          "receptor_entry_name": {
            "type": "string",
            "minLength": 1,
            "description": "GPCRdb entry name, e.g. 'p2ry1_human'. The join key everywhere."
          },
          "receptor_display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "gene_symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "species": {
            "type": "string"
          },
          "accession": {
            "type": [
              "string",
              "null"
            ]
          },
          "major_family_source_id": {
            "type": "string"
          },
          "receptor_family_source_id": {
            "type": "string"
          },
          "source_family_path": {
            "type": [
              "array",
              "string",
              "null"
            ]
          },
          "project_slug": {
            "type": "string",
            "pattern": "^ca-"
          },
          "structure_pdb_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9A-Z]{4}$"
            }
          }
        }
      }
    }
  }
}
