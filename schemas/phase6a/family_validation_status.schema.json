{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "family_validation_status",
 "description": "Per family x site class x ligand form contact-rule validation scope. Generated from the real corpus; combinations that do not occur are not invented.",
 "type": "object",
 "required": [
  "major_family_id",
  "family_name",
  "transfer_status",
  "statement_tr",
  "statement_en",
  "contact_definition",
  "limitations"
 ],
 "properties": {
  "major_family_id": {
   "type": "string"
  },
  "family_name": {
   "type": "string"
  },
  "site_class": {
   "type": [
    "string",
    "null"
   ]
  },
  "ligand_entity_form": {
   "type": [
    "string",
    "null"
   ]
  },
  "aggregation_units": {
   "type": "integer",
   "minimum": 0
  },
  "contact_definition": {
   "type": "string"
  },
  "reference_test_status": {
   "type": "string"
  },
  "reference_structure_count": {
   "type": "integer",
   "minimum": 0
  },
  "reference_family": {
   "type": [
    "string",
    "null"
   ]
  },
  "reference_ligand_scope": {
   "type": "string"
  },
  "independent_human_validation_status": {
   "type": "string"
  },
  "transfer_status": {
   "enum": [
    "reference_tested_within_scope",
    "transferred_without_family_specific_reference_test",
    "descriptive_interface_rule_not_independently_reference_tested",
    "covalent_relation_verified_contact_shell_not_independently_tested",
    "not_applicable",
    "unresolved"
   ]
  },
  "limitations": {
   "type": "string"
  },
  "statement_tr": {
   "type": "string",
   "minLength": 20
  },
  "statement_en": {
   "type": "string",
   "minLength": 20
  },
  "source_report": {
   "type": "string"
  },
  "source_hash": {
   "type": "string"
  }
 }
}
