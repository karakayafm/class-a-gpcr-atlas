{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/class-a-gpcr-atlas/schemas/structure_record.schema.json",
  "title": "Structure record (Phase 2)",
  "description": "One row per Class A structure. Structure-anchored per OD-02: ligands hang off the structure, the structure does not hang off a ligand, and a structure may carry zero, one or many pharmacological ligands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pdb_id",
    "major_family_id",
    "major_family_name",
    "receptor_family_id",
    "receptor_family_name",
    "receptor_name",
    "species",
    "experimental_method",
    "resolution",
    "release_date",
    "receptor_instances",
    "construct_engineering_status",
    "structure_source_provenance",
    "metadata_completeness",
    "structure_status",
    "ligand_status",
    "apo_status",
    "apo_assignment_basis",
    "pharmacological_ligand_count",
    "unresolved_candidate_count"
  ],
  "properties": {
    "pdb_id": {
      "type": "string",
      "pattern": "^[0-9A-Z]{4}$"
    },
    "gpcrdb_structure_id": {
      "type": "string"
    },
    "major_family_id": {
      "type": "string"
    },
    "major_family_name": {
      "type": "string"
    },
    "receptor_family_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "receptor_family_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "receptor_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "receptor_entry_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "species": {
      "type": "string",
      "description": "Mandatory per OD-04. Orthologues are never merged."
    },
    "experimental_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolution": {
      "type": [
        "number",
        "null"
      ]
    },
    "release_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "deposition_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "receptor_instances": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "receptor_instance_count": {
      "type": "integer",
      "minimum": 1
    },
    "construct_engineering_status": {
      "enum": [
        "chimeric_fusion",
        "mutations_reported",
        "none_reported",
        "source_not_loaded"
      ]
    },
    "entity_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "solvent_summary": {
      "type": "object",
      "additionalProperties": true,
      "description": "Water is summarised here and never inventoried per molecule."
    },
    "ligand_status": {
      "enum": [
        "ligand_bound",
        "multi_ligand_bound",
        "no_pharmacological_ligand_detected",
        "unresolved"
      ]
    },
    "apo_status": {
      "enum": [
        "confirmed_apo",
        "probable_apo",
        "not_apo",
        "unresolved"
      ],
      "description": "Never derived from nonpolymer_count == 0. confirmed_apo requires positive source evidence AND no unresolved candidate of any ligand form."
    },
    "apo_assignment_basis": {
      "type": "string",
      "minLength": 1
    },
    "apo_forms_checked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 7,
      "description": "Per OD-03 every ligand form must be checked before apo may be assigned."
    },
    "pharmacological_ligand_count": {
      "type": "integer",
      "minimum": 0
    },
    "unresolved_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "metadata_completeness": {
      "enum": [
        "complete",
        "rcsb_metadata_absent"
      ]
    },
    "structure_source_provenance": {
      "type": "object",
      "required": [
        "source_state"
      ],
      "additionalProperties": true
    },
    "structure_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase1_qc_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
