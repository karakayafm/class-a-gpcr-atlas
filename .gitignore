# Caches and build residue
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
node_modules/

# Local artefacts that must never be published
*.part
*.tmp
*.log
.env
.DS_Store

# Working data that is not part of the publication package
data/cache/
data/raw/
releases/
reports/
curation/packets/
drafts/
# The Phase 5 suite stays out of the publication package, but the deploy guard must ship:
# an untracked test is not a reproducible one, and this test protects the published branch.
# Git cannot re-include a file whose parent directory is excluded, hence the step-by-step form.
tests/*
!tests/deploy/
tests/deploy/*
!tests/deploy/test_gh_pages_protection.py
!tests/enrichment/
tests/enrichment/*
!tests/enrichment/test_chemistry_smarts.py
_checksums_*.sha256
