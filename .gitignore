# Caches and build residue
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
node_modules/

# Local artefacts that must never be published
*.part
*.tmp
*.log
.env
.DS_Store

# Working data that is not part of the publication package
data/cache/
data/raw/
# Enrichment intermediates. The published payload under site/data/web is the artefact;
# the step that produces it re-runs from the cache and its intermediate is not shipped.
data/intermediate/
# The rest of the pipeline's working tree. Nothing under data/ is tracked - the published
# artefact is site/data/web - but only three directories were named here, so a populated
# data/ left ~900 MB of build inputs and outputs untracked and unignored, one `git add -A`
# away from a commit.
data/aggregates/
data/contacts/
data/curation/
data/freezes/
data/licences/
data/manifests/
data/normalized/
data/pilots/
data/web/
releases/
reports/
curation/packets/
drafts/
# An untracked test is not a reproducible one, so every suite that guards the published site
# ships here — including Phase 5, which was previously left in the working directory and so
# existed on one disk only. Its fixtures (data/web, releases/) are not published; it reports
# what it cannot reach rather than passing silently.
# Git cannot re-include a file whose parent directory is excluded, hence the step-by-step form.
tests/*
!tests/deploy/
tests/deploy/*
!tests/deploy/test_gh_pages_protection.py
!tests/deploy/test_repo_hygiene.py
!tests/validation/
tests/validation/*
!tests/validation/test_contact_rule_reference.py
!tests/enrichment/
tests/enrichment/*
!tests/enrichment/test_chemistry_smarts.py
!tests/phase5/
tests/phase5/*
!tests/phase5/run_tests.py
!tests/phase5/browser_tests.py
!tests/phase5/cdp.py
!tests/phase5/p8_smoke.py
_checksums_*.sha256

# Governance notes kept outside the repository. Not recoverable from here - keep a backup.
governance/*.local.json
