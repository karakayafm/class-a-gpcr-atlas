# Caches and build residue
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
node_modules/

# Local artefacts that must never be published
*.part
*.tmp
*.log
.env
.DS_Store

# Working data that is not part of the publication package
data/cache/
data/raw/
releases/
reports/
curation/packets/
drafts/
# An untracked test is not a reproducible one, so every suite that guards the published site
# ships here — including Phase 5, which was previously left in the working directory and so
# existed on one disk only. Its fixtures (data/web, releases/) are not published; it reports
# what it cannot reach rather than passing silently.
# Git cannot re-include a file whose parent directory is excluded, hence the step-by-step form.
tests/*
!tests/deploy/
tests/deploy/*
!tests/deploy/test_gh_pages_protection.py
!tests/deploy/test_repo_hygiene.py
!tests/enrichment/
tests/enrichment/*
!tests/enrichment/test_chemistry_smarts.py
!tests/phase5/
tests/phase5/*
!tests/phase5/run_tests.py
!tests/phase5/browser_tests.py
!tests/phase5/cdp.py
!tests/phase5/p8_smoke.py
_checksums_*.sha256
